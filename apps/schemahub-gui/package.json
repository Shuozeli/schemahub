{
  "name": "schemahub-gui",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test:bundle": "node scripts/validate-bundle-size.mjs && node scripts/test-validate-bundle.mjs",
    "test:cdp": "node --test ../browser-cdp.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:live": "node scripts/live-browser-smoke.mjs"
  },
  "dependencies": {
    "@mantine/core": "^8.3.8",
    "@mantine/hooks": "^8.3.8",
    "@tanstack/react-query": "^5.90.12",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.2",
    "playwright-core": "1.61.1",
    "typescript": "^5.9.3",
    "vite": "7.3.6"
  }
}
