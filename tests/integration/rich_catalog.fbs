include "acme/core/catalog/common.fbs";

namespace local.rich.catalog;

enum Availability : byte {
  Unknown = 0,
  InStock = 1,
  Backordered = 2,
  Discontinued = 3
}

table Supplier {
  id: string (key, id: 0);
  display_name: string (required, id: 1);
  minimum_order: Money (id: 2);
}

table CatalogItem {
  id: string (key, id: 0);
  sku: string (required, id: 1);
  title: string (id: 2);
  availability: Availability = InStock (id: 3);
  supplier: Supplier (id: 4);
  warehouse_aisle: short (id: 5);
  warehouse_bay: short (id: 6);
  tags: [string] (id: 7);
  related_items: [CatalogItem] (id: 8);
  deprecated_rank: int (deprecated, id: 9);
}

table CatalogGroup {
  id: string (key, id: 0);
  featured_items: [CatalogItem] (id: 1);
}

union CatalogEntity {
  item: CatalogItem,
  supplier: Supplier,
  group: CatalogGroup
}

table CatalogEnvelope {
  id: string (key, id: 0);
  entity: CatalogEntity (id: 1);
}

root_type CatalogEnvelope;
file_identifier "RCAT";
file_extension "rcat";
