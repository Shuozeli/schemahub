FROM rust:1.95.0-bookworm

WORKDIR /workspace/shuozeli/codegen/schemahub

# The build context is created by run_e2e.sh and contains:
#   shuozeli/codegen/schemahub
# Compiler crates resolve from immutable Git revisions in Cargo.lock, so no
# sibling repository source is present in the context.
COPY shuozeli/codegen/schemahub /workspace/shuozeli/codegen/schemahub

RUN CARGO_INCREMENTAL=0 cargo build --release --locked \
  -p schemahub-server -p schemahub-cli

ENV PATH="/workspace/shuozeli/codegen/schemahub/target/release:${PATH}"
WORKDIR /work
